<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:orientation="vertical"
              android:padding="12dp">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

        <EditText
                android:id="@+id/ignored_callsign_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/ignored_callsign_hint"
                android:inputType="text"
                android:maxLines="1"/>

        <EditText
                android:id="@+id/ignored_callsign_band_value"
                android:layout_width="88dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:hint="@string/ignored_band_hint"
                android:inputType="text"
                android:maxLines="1"/>

        <Button
                android:id="@+id/add_ignored_callsign"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/add_pattern"/>
    </LinearLayout>

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

        <EditText
                android:id="@+id/ignored_callsign_search_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/search_callsign"
                android:inputType="text"
                android:maxLines="1"/>
    </LinearLayout>

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

        <Button
                android:id="@+id/import_ignored_callsigns_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/import_ignored_callsigns"/>

        <Button
                android:id="@+id/clear_all_ignored_callsigns_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/clear_all_ignored_callsigns"/>
    </LinearLayout>

    <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/ignored_callsign_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="12dp"
                android:scrollbars="vertical"/>

        <TextView
                android:id="@+id/empty_ignored_callsigns"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="@string/no_ignored_callsigns"
                android:textSize="14sp"/>
    </FrameLayout>

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

        <Button
                android:id="@+id/previous_ignored_callsign_page"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/previous_page"/>

        <TextView
                android:id="@+id/ignored_callsign_page_info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:gravity="center"
                android:textSize="14sp"/>

        <Button
                android:id="@+id/next_ignored_callsign_page"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/next_page"/>
    </LinearLayout>
</LinearLayout>
