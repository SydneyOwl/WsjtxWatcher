<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:orientation="vertical"
              android:padding="10dp">

    <LinearLayout
            android:id="@+id/status_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="vertical">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

            <TextView
                    android:id="@+id/total_record"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/total_record"/>

            <TextView
                    android:id="@+id/about_me"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="@string/about_me"/>
        </LinearLayout>

        <TextView
                android:id="@+id/current_source_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/textview_message_color"
                android:textSize="14sp"/>
    </LinearLayout>

    <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/calllist_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="64dp"
                android:scrollbars="vertical"/>

        <RelativeLayout
                android:id="@+id/transmittingLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:background="@color/transmitLayout_background"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:visibility="visible">

            <ImageView
                    android:id="@+id/imageView2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_baseline_campaign_transmitting_red_24"/>

            <TextView
                    android:id="@+id/transmittingMessageTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="8dp"
                    android:layout_toEndOf="@id/imageView2"
                    android:stateListAnimator="@anim/view_blink"
                    android:text=""
                    android:textColor="@color/bar_text_view_color"
                    android:visibility="visible"/>
        </RelativeLayout>

        <EditText
                android:id="@+id/callsign_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginTop="8dp"
                android:hint="@string/search_callsign"
                android:inputType="text"
                android:maxLines="1"/>

        <ImageButton
                android:id="@+id/jump_to_bottom_button"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="76dp"
                android:background="@drawable/floating_jump_button_background"
                android:contentDescription="@string/jump_to_bottom"
                android:elevation="6dp"
                android:padding="12dp"
                android:src="@android:drawable/arrow_down_float"
                android:tint="@android:color/white"/>
    </FrameLayout>

</LinearLayout>
