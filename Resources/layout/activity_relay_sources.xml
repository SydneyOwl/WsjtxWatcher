<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F6FB"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/relay_source_page_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/textview_message_color"
        android:textSize="15sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/relay_source_page_refresh"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/relay_refresh_sources" />

    <ListView
        android:id="@+id/relay_source_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:dividerHeight="8dp" />

    <TextView
        android:id="@+id/relay_source_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="12dp"
        android:text="@string/relay_source_picker_empty"
        android:textColor="@color/text_view_color"
        android:textSize="15sp"
        android:visibility="gone" />
</LinearLayout>
